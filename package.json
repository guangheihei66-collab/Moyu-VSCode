{
  "name": "moyu-vscode",
  "displayName": "Moyu VS Code",
  "description": "A local-only leisure center for VS Code.",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [
    "onCommand:moyu.open",
    "onView:moyu.sidebar"
  ],
  "contributes": {
    "commands": [
      {
        "command": "moyu.open",
        "title": "Moyu: Open"
      },
      {
        "command": "moyu.openBooks",
        "title": "Moyu: Open Books"
      },
      {
        "command": "moyu.open2048",
        "title": "Moyu: Open 2048"
      },
      {
        "command": "moyu.openSettings",
        "title": "Moyu: Open Settings"
      },
      {
        "command": "moyu.toggleBossMode",
        "title": "Moyu: Toggle Boss Mode",
        "enablement": "moyu.isOpen && moyu.isVisible"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moyu",
          "title": "Moyu",
          "icon": "media/moyu.svg"
        }
      ]
    },
    "views": {
      "moyu": [
        {
          "id": "moyu.sidebar",
          "name": "Moyu"
        }
      ]
    },
    "keybindings": [
      {
        "command": "moyu.toggleBossMode",
        "key": "ctrl+m",
        "when": "moyu.isOpen && moyu.isVisible"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:extension": "npm run test:extension:current",
    "test:extension:contract": "node scripts/test-extension-contract.mjs",
    "test:extension:current": "npm run build && node --experimental-strip-types test/extension/runTests.ts --lane current",
    "test:extension:min": "npm run build && node --experimental-strip-types test/extension/runTests.ts --lane min",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "npm run format:check && npm run lint && npm test && npm run test:extension:contract && npm run build && npm run test:extension:current && npm run test:extension:min && node scripts/scan-package-secrets.mjs && vsce ls && vsce package --no-yarn --allow-missing-repository && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.8.60",
    "iconv-lite": "0.7.3",
    "parse5": "8.0.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "20.17.30",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.0.0"
  },
  "overrides": {
    "vite": "7.1.12"
  }
}
